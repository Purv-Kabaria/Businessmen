# Database (Prisma)
DATABASE_URL=
# Used during development (optional, for migration/sync scripts)
DATABASE_MAIN=
DATABASE_LOCAL=

# Server Configuration
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Application
APP_NAME="FinBridge"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis (BullMQ - transcribe/contacts workers)
# Use local Redis or Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local fallback:
REDIS_URL=redis://127.0.0.1:6379
# Force local Redis even if Upstash is set:
# USE_LOCAL_REDIS=true

# --- AI & PYTHON BACKEND ---

# Next.js -> Python Backend Connectivity
PYTHON_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_TRANSCRIBE_API_URL=http://127.0.0.1:8000/api/transcribe

# Python Backend Internal Configuration (os.environ in python_backend)
# WHISPER_MODEL size: 'base', 'small', 'medium', 'large-v3', etc.
WHISPER_MODEL=medium
# Directory to cache large models locally (avoids re-downloading)
WHISPER_CACHE_DIR=./models/whisper

# Ollama Connectivity (for Vision OCR, Summary, and Simulation)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_SUMMARY_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b

# --- STORAGE (MinIO / S3) ---

# Next.js side connectivity
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=interactions-audio

# --- EXTERNAL INTEGRATIONS ---

# Google (Gmail + Calendar + Meet) – automatic meeting scheduler
# Create OAuth 2.0 credentials in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar ID: "primary" or specific email
GOOGLE_CALENDAR_ID=primary

# Meeting Schedule run trigger (protects the cron endpoint)
MEETING_SCHEDULE_SECRET=